-- Generated by cm.py from collide.p: a 1-element counter-model.
set_option autoImplicit false  -- an unbound name is an error, never silently quantified
set_option maxRecDepth 100000  -- long formulas recurse deeply
set_option maxHeartbeats 0  -- no per-proof cap: the build's wall clock is the budget
set_option synthInstance.maxSize 100000  -- deep formulas need deep instance search
namespace collide

inductive T | e1
  deriving DecidableEq

def T.all : List T := [T.e1]
theorem T.mem (x : T) : x ∈ T.all := by cases x <;> decide
def T.idx : T → Nat
  | T.e1 => 0
instance (p : T → Prop) [DecidablePred p] : Decidable (∀ x, p x) :=
  decidable_of_iff (∀ x ∈ T.all, p x) ⟨fun h x => h x (T.mem x), fun h x _ => h x⟩
instance (p : T → Prop) [DecidablePred p] : Decidable (∃ x, p x) :=
  decidable_of_iff (∃ x ∈ T.all, p x) ⟨fun ⟨x, _, h⟩ => ⟨x, h⟩, fun ⟨x, h⟩ => ⟨x, T.mem x, h⟩⟩

abbrev «c0» : T := T.e1
abbrev «'countermodel'» : T := T.e1
abbrev «chunk0» : Prop := True
abbrev «p0» (x0 : T) : Prop := (1 >>> (1 * x0.idx)) % 2 = 1
abbrev «q» (x0 : T) : Prop := (0 >>> (1 * x0.idx)) % 2 = 1

theorem c0' : («c0» = «'countermodel'») := by decide

theorem c1' : ((«p0» «c0») ∧ «chunk0») := by decide

theorem c2' : ¬(«q» «'countermodel'») := by decide

theorem countermodel : Nonempty T ∧ (((«c0» = «'countermodel'»)) ∧ ((((«p0» «c0») ∧ «chunk0»)) ∧ (¬(«q» «'countermodel'»)))) :=
  ⟨⟨T.e1⟩, ⟨c0', ⟨c1', c2'⟩⟩⟩

end collide
#print axioms collide.countermodel
#check @collide.countermodel
