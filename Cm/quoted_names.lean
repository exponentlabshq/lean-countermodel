-- Generated by cm.py from quoted_names.p: a 2-element counter-model.
set_option autoImplicit false  -- an unbound name is an error, never silently quantified
set_option maxRecDepth 100000  -- long formulas recurse deeply
set_option maxHeartbeats 0  -- no per-proof cap: the build's wall clock is the budget
set_option synthInstance.maxSize 100000  -- deep formulas need deep instance search
namespace quoted_names

inductive T | e1 | e2
  deriving DecidableEq

def T.all : List T := [T.e1, T.e2]
theorem T.mem (x : T) : x ∈ T.all := by cases x <;> decide
def T.idx : T → Nat
  | T.e1 => 0 | T.e2 => 1
instance (p : T → Prop) [DecidablePred p] : Decidable (∀ x, p x) :=
  decidable_of_iff (∀ x ∈ T.all, p x) ⟨fun h x => h x (T.mem x), fun h x _ => h x⟩
instance (p : T → Prop) [DecidablePred p] : Decidable (∃ x, p x) :=
  decidable_of_iff (∃ x ∈ T.all, p x) ⟨fun ⟨x, _, h⟩ => ⟨x, h⟩, fun ⟨x, h⟩ => ⟨x, T.mem x, h⟩⟩

abbrev «'50% off'» : T := T.e1
abbrev «'don\'t'» : T := T.e1
abbrev «'Alps'» : T := T.e1
abbrev «'Switzerland'» : T := T.e1
abbrev «on_sale» (x0 : T) : Prop := (1 >>> (1 * x0.idx)) % 2 = 1
abbrev «said» (x0 : T) : Prop := (3 >>> (1 * x0.idx)) % 2 = 1
abbrev «in» (x0 x1 : T) : Prop := (15 >>> (1 * x0.idx + 2 * x1.idx)) % 2 = 1

theorem c0' : (((«on_sale» «'50% off'») ∧ («said» «'don\'t'»)) ∧ («in» «'Alps'» «'Switzerland'»)) := by decide

theorem c1' : ¬(∀ X' : T, («on_sale» X')) := by decide

theorem countermodel : Nonempty T ∧ (((((«on_sale» «'50% off'») ∧ («said» «'don\'t'»)) ∧ («in» «'Alps'» «'Switzerland'»))) ∧ (¬(∀ X' : T, («on_sale» X')))) :=
  ⟨⟨T.e1⟩, ⟨c0', c1'⟩⟩

end quoted_names
