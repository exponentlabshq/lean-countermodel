abbrev «isIdea» (x0 : T) : Prop := (3 >>> (1 * x0.idx)) % 2 = 1

theorem c0' : (∀ C' E' : T, (¬(«cause» C' E') ∨ («conceivedThrough» E' C'))) := by decide

theorem c1' : (∀ C' E' : T, (¬(«conceivedThrough» E' C') ∨ («cause» C' E'))) := by decide

theorem c2' : (∀ IC' IE' : T, (¬(«conceivedThrough» IE' IC') ∨ (∀ E' : T, (¬(«ideaOf» IE' E') ∨ (∀ C' : T, (¬(«ideaOf» IC' C') ∨ («conceivedThrough» E' C'))))))) := by decide

theorem c3' : (∀ I' : T, (¬(«isIdea» I') ∨ (∀ J' : T, (¬(«isIdea» J') ∨ (¬(«conceivedThrough» I' J') ∨ («cause» J' I')))))) := by decide

theorem c4' : (∀ I' : T, (¬(«isIdea» I') ∨ (∀ J' : T, (¬(«isIdea» J') ∨ (¬(«cause» J' I') ∨ («conceivedThrough» I' J')))))) := by decide

theorem c5' : (∀ I' : T, ((«isIdea» I') ∨ (∀ X' : T, ¬(«ideaOf» I' X')))) := by decide

theorem c6' : ¬(∀ I' X' : T, (¬(«ideaOf» I' X') ∨ (∀ Y' : T, (¬(«cause» X' Y') ∨ (∀ J' : T, (¬(«ideaOf» J' Y') ∨ («cause» I' J'))))))) := by decide

theorem countermodel : Nonempty T ∧ ((((∀ C' E' : T, (¬(«cause» C' E') ∨ («conceivedThrough» E' C')))) ∧ (((∀ C' E' : T, (¬(«conceivedThrough» E' C') ∨ («cause» C' E')))) ∧ ((∀ IC' IE' : T, (¬(«conceivedThrough» IE' IC') ∨ (∀ E' : T, (¬(«ideaOf» IE' E') ∨ (∀ C' : T, (¬(«ideaOf» IC' C') ∨ («conceivedThrough» E' C')))))))))) ∧ ((((∀ I' : T, (¬(«isIdea» I') ∨ (∀ J' : T, (¬(«isIdea» J') ∨ (¬(«conceivedThrough» I' J') ∨ («cause» J' I'))))))) ∧ ((∀ I' : T, (¬(«isIdea» I') ∨ (∀ J' : T, (¬(«isIdea» J') ∨ (¬(«cause» J' I') ∨ («conceivedThrough» I' J')))))))) ∧ (((∀ I' : T, ((«isIdea» I') ∨ (∀ X' : T, ¬(«ideaOf» I' X'))))) ∧ (¬(∀ I' X' : T, (¬(«ideaOf» I' X') ∨ (∀ Y' : T, (¬(«cause» X' Y') ∨ (∀ J' : T, (¬(«ideaOf» J' Y') ∨ («cause» I' J'))))))))))) :=
